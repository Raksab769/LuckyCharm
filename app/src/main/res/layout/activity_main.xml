<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/subtitle"
        android:textSize="14sp"
        android:alpha="0.7" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/status_permission_needed"
        android:textAlignment="center" />

    <Button
        android:id="@+id/grantPermissionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/grant_permission" />

    <GridLayout
        android:id="@+id/charmGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="3"
        android:rowCount="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="bottom">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensitivity"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/sensitivityValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5%"
            android:textSize="12sp"
            android:alpha="0.7" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/gyroSensitivityBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="200"
        android:progress="5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Custom Color (Optional)"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/colorPalette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <Button android:id="@+id/colorDefault" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp" android:backgroundTint="#FFFFFF" android:text="X"/>
        <Button android:id="@+id/colorRed" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp" android:backgroundTint="#E63946"/>
        <Button android:id="@+id/colorBlue" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp" android:backgroundTint="#4EA8DE"/>
        <Button android:id="@+id/colorGreen" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp" android:backgroundTint="#3FA34D"/>
        <Button android:id="@+id/colorGold" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp" android:backgroundTint="#C9962C"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Position"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <Button android:id="@+id/posLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Left"/>
        <Button android:id="@+id/posCenter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Center"/>
        <Button android:id="@+id/posRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Right"/>
    </LinearLayout>

    <Button
        android:id="@+id/hangButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/hang_charm"
        android:enabled="false" />

    <Button
        android:id="@+id/hideButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hide_charm" />

</LinearLayout>
