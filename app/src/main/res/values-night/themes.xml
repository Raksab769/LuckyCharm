<resources>
    <style name="Theme.LuckyCharm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/cyan_500</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="dialogTheme">@style/Theme.LuckyCharm.Dialog</item>
        <item name="colorSurface">@color/panel_dark</item>
        <item name="colorOutline">@color/stroke_dark</item>
    </style>

    <style name="Theme.LuckyCharm.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
    </style>
</resources>
